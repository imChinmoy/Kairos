# ==================================================
# KAIROS Mobile API — Environment Configuration
# Copy this file to .env and fill in values.
# DO NOT commit .env to version control.
# ==================================================

# Application
NODE_ENV=development
PORT=3000
SERVICE_NAME=kairos-mobile-api

# MongoDB
# Example: mongodb://localhost:27017/kairos
# Example (Atlas): mongodb+srv://user:pass@cluster.mongodb.net/kairos
MONGO_URI=mongodb://localhost:27017/kairos

# JWT
# Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_a_very_long_random_secret_min_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — Comma-separated list of allowed origins
# Example: http://localhost:3000,https://kairos.yourdomain.in
CORS_ORIGIN=http://localhost:3000

# FastAPI Integration
FASTAPI_BASE_URL=http://localhost:8080

# File Storage
# Options: local | s3 | gcs | cloudinary
FILE_STORAGE_MODE=local
UPLOAD_DIR=./uploads

# File limits
MAX_FILE_SIZE_MB=25

# AWS S3 (if FILE_STORAGE_MODE=s3)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Google Cloud Storage (if FILE_STORAGE_MODE=gcs)
GCS_BUCKET=
GCS_KEY_FILE=

# Cloudinary (if FILE_STORAGE_MODE=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Map Providers (for metadata/configuration endpoints)
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Emergency Services — Read from backend, NOT hardcoded in app
SOS_COAST_GUARD_NUMBER=
SOS_LOCAL_AUTHORITY_NUMBER=
SOS_EMERGENCY_CONTACT_NUMBER=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
